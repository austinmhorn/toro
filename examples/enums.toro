enum Message {
    text(string)
    count(int)
    quit
}

function process(message: Message) {
    handle message {
        text(value) {
            print(value)
        }

        count(value) {
            print(value)
        }

        quit {
            print("done")
        }
    }
}

function main() {
    message := Message::text("hello")
    count := Message::count(10)
    quit := Message::quit
    process(message)
    process(count)
    process(quit)
}
