enum Message {
    text(string)
    quit
}

function process(message: Message) {
    handle message {
        text(value) {
            print(value)
        }

        quit {
            return
        }
    }
}

function parse_age(text: string) -> Result<int, string> {
    if text == "" {
        return error("empty input")
    }

    return ok(28)
}

function checked_age() -> Result<int, string> {
    age := parse_age("28")?
    return ok(age)
}

function report_age(result: Result<int, string>) {
    handle result {
        ok(age) {
            print(age)
        }

        error(problem) {
            print(problem)
        }
    }
}

function main() {
    message := Message.text("hello")
    quit := Message.quit
    process(message)
    process(quit)
    age_result: Result<int, string> = checked_age()
    report_age(age_result)
}
