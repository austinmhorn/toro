interface Serializable {
    function serialize() -> string
}

interface Comparable {
    function compare(other: Comparable) -> int
}

class Value implements Serializable, Comparable {
    public function serialize() -> string {
        return "value"
    }

    public function compare(other: Comparable) -> int {
        return 0
    }
}

struct Pair<A, B> {
    first: A
    second: B
}

class Box<T> {
    public value: T

    public function get() -> T {
        return self.value
    }

    public function replace(value: T) {
        self.value = value
    }
}

class SortedBox<T: Serializable + Comparable> {
    public value: T
}

function max<T: Serializable + Comparable>(a: T, b: T) -> T {
    return a
}

function preserve<T>(items: Map<string, List<T>>) -> Map<string, List<T>> {
    return items
}

function verify_collections(items: Map<string, List<Value>>) {
    values: Map<string, List<Value>> = preserve(items)
    print(values)
}

function main() {
    explicit_pair := Pair<int, string>(first: 1, second: "one")
    inferred_pair := Pair(first: 2, second: "two")
    box: Box<int> = Box(value: 10)
    box.replace(20)
    number: int = box.get()
    sorted := SortedBox(value: Value())
    value := max<Value>(Value(), Value())
    print(explicit_pair)
    print(inferred_pair)
    print(number)
    print(sorted)
    print(value)
}
