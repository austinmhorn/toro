interface Named {
    function name() -> string
}

interface Tagged {
    function tag() -> string
}

class NamedValue implements Named, Tagged {
    public label: string

    init(label: string) {
        self.label = label
    }

    public function name() -> string {
        return self.label
    }

    public function tag() -> string {
        return "value"
    }
}

function identity<T>(value: T) -> T {
    return value
}

function preserve_named<T: Named + Tagged>(value: T) -> T {
    return value
}

struct Box<T> {
    value: T

    function echo<U>(value: U) -> U {
        return value
    }
}

class Holder<T> {
    public value: T

    init(value: T) {
        self.value = value
    }

    public function echo<U>(value: U) -> U {
        return value
    }
}

class Resource {
    public name: string

    destroy() {
        print("resource destroyed")
    }
}

function pass<T>(value: T) -> T {
    return value
}

function wrap<T>(value: T) -> Result<T, string> {
    return ok(value)
}

function main() {
    number := identity(10)
    text := identity<string>("Toro")

    boxed := Box(value: 42)
    zero := Box<int>()
    words := Box<string>(value: "hello")
    nested := Box<Box<int>>(value: pass(boxed))

    holder := Holder(number)
    resource := Resource(name: "owned")
    kept := pass(resource)
    resource_holder := Holder<Resource>(kept)
    nullable_holder := Holder<Resource?>(null)
    named := preserve_named(NamedValue("constrained"))
    result := wrap<string>("result")

    print(number)
    print(zero.value)
    print(text)
    print(boxed.echo<string>(words.value))
    print(nested.value.value)
    print(holder.value)
    print(holder.echo<string>("class method"))
    print(resource_holder.value.name)
    print(nullable_holder.value == null)
    print(named.name())

    handle result {
        ok(value) {
            print(value)
        }

        error(problem) {
            print(problem)
        }
    }
}
