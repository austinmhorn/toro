performance function increment(value: int) -> int {
    return value + 1
}

class Counter {
    public performance function next(value: int) -> int {
        return increment(value)
    }
}

class Particle {
    public value: int = 0

    public function tick() {
        self.value = self.value + 1
    }
}

performance function update() {
    particle := Particle()
    particle.tick()
}

function main() {
    update()
    counter := Counter()
    print(counter.next(41))
}
