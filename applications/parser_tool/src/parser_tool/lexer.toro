import strings
import parser_tool.model

public performance function is_digit(value: int) -> bool {
    return value >= 48 and value <= 57
}

public performance function is_identifier_start(value: int) -> bool {
    return value == 95 or value >= 65 and value <= 90 or value >= 97 and value <= 122
}

public performance function is_identifier_continue(value: int) -> bool {
    return is_identifier_start(value) or is_digit(value)
}

function token_kind(identifier: string) -> TokenKind {
    if identifier == "entity" {
        return TokenKind::entity_keyword
    }
    if identifier == "link" {
        return TokenKind::link_keyword
    }
    return TokenKind::identifier
}

public function tokenize(source: string, tokens: List<Token>) -> Result<bool, string> {
    tokens.reserve(length(source))
    index := 0
    line := 1
    column := 1
    count := length(source)
    while index < count {
        current := byte_at(source, index)?
        if current == 10 {
            index = index + 1
            line = line + 1
            column = 1
        } else if current == 9 or current == 13 or current == 32 {
            index = index + 1
            column = column + 1
        } else if is_identifier_start(current) {
            start := index
            start_column := column
            while index < count and is_identifier_continue(byte_at(source, index)?) {
                index = index + 1
                column = column + 1
            }
            lexeme := substring(source, start, index - start)?
            tokens.add(Token(kind: token_kind(lexeme), lexeme: lexeme, line: line, column: start_column))
        } else if is_digit(current) {
            start := index
            start_column := column
            while index < count and is_digit(byte_at(source, index)?) {
                index = index + 1
                column = column + 1
            }
            lexeme := substring(source, start, index - start)?
            tokens.add(Token(kind: TokenKind::integer, lexeme: lexeme, line: line, column: start_column))
        } else if current == 91 {
            start_column := column
            index = index + 1
            column = column + 1
            start := index
            terminated := false
            while index < count and terminated == false {
                next := byte_at(source, index)?
                if next == 93 {
                    terminated = true
                } else {
                    index = index + 1
                    column = column + 1
                }
            }
            if terminated == false {
                return error("unterminated string literal")
            }
            lexeme := substring(source, start, index - start)?
            index = index + 1
            column = column + 1
            tokens.add(Token(kind: TokenKind::text, lexeme: lexeme, line: line, column: start_column))
        } else if current == 123 {
            tokens.add(Token(kind: TokenKind::left_brace, lexeme: "{", line: line, column: column))
            index = index + 1
            column = column + 1
        } else if current == 125 {
            tokens.add(Token(kind: TokenKind::right_brace, lexeme: "}", line: line, column: column))
            index = index + 1
            column = column + 1
        } else if current == 58 {
            tokens.add(Token(kind: TokenKind::colon, lexeme: ":", line: line, column: column))
            index = index + 1
            column = column + 1
        } else if current == 45 and index + 1 < count and byte_at(source, index + 1)? == 62 {
            tokens.add(Token(kind: TokenKind::arrow, lexeme: "->", line: line, column: column))
            index = index + 2
            column = column + 2
        } else {
            index = index + 1
            column = column + 1
        }
    }
    tokens.add(Token(kind: TokenKind::end_of_file, lexeme: "", line: line, column: column))
    return ok(true)
}

public function parse_integer(value: string) -> Result<int, string> {
    result := 0
    index := 0
    while index < length(value) {
        current := byte_at(value, index)?
        if is_digit(current) == false {
            return error("invalid integer")
        }
        result = result * 10 + current - 48
        index = index + 1
    }
    return ok(result)
}
